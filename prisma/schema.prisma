generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String   // Clerk User ID for multi-user data isolation
  mood      Int      // 1 to 5 mood scale
  note      String?  // Optional short note (max 280 chars)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Reflection {
  id        String   @id @default(cuid())
  userId    String   // Clerk User ID for multi-user data isolation
  topic     String   // The core challenge or topic chosen
  lens      String   // The philosophical lens used (e.g. 'gita', 'stoic', etc.)
  answers   String   // JSON string of answers array (Fixed for Claude's journal.ts)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}