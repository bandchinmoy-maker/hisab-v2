generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kept so the old ledger table (and its data) is NOT deleted when you run db push.
model Transaction {
  id          String   @id @default(cuid())
  text        String
  amount      Float
  amountINR   Float?
  type        String
  category    String
  paymentMode String
  bankAccount String   @default("Main Cash Drawer")
  country     String   @default("India")
  currency    String   @default("INR")
  symbol      String   @default("₹")
  date        String
  createdAt   DateTime @default(now())
  userId      String   @default("")

  @@index([userId])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String   // Clerk User ID for multi-user data isolation
  mood      Int      // 1 to 5 mood scale
  note      String?  // Optional short note (max 280 chars)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Reflection {
  id        String   @id @default(cuid())
  userId    String   // Clerk User ID for multi-user data isolation
  topic     String   // The core challenge or topic chosen
  lens      String   // The philosophical lens used (e.g. 'gita', 'stoic', etc.)
  answers   String   // JSON string of the answers array
  moodBefore Int?    // optional 1 to 5, before reflecting
  moodAfter  Int?    // optional 1 to 5, after reflecting
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
